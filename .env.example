# Loopback-only application listener for the host TLS reverse proxy.
UCM_BIND_ADDRESS=127.0.0.1
UCM_HTTP_PORT=8080

# Persistent bind mounts. Keep these on backed-up local storage.
# The production app creates a new verified backup here every day at 06:00
# Pacific/Auckland. Automated backups are never deleted; monitor capacity and
# copy completed backup directories to encrypted off-host storage.
UCM_DATA_DIR=./data
UCM_OUTPUT_DIR=./output
UCM_BACKUP_DIR=./backups

# Required. Generate distinct URL-safe values, for example:
#   openssl rand -hex 32
# PostgreSQL is not exposed on a host port. The migrator credential is used
# only by the one-shot migration/restore containers; the app uses ucm_app.
# The migration service idempotently provisions/rotates ucm_app from the
# application password, including when a retained volume is missing the role.
UCM_DB_MIGRATOR_PASSWORD=
UCM_DB_APP_PASSWORD=

# Required production access keys. Editors, viewers, and administrators each
# use a separate role-class key. Generate each value independently with at
# least 32 bytes, keep all three values distinct from one
# another and every other secret, and protect them like production passwords:
#   openssl rand -hex 32
# Changing either value invalidates existing browser sessions that used it.
UCM_SHARED_ACCESS_KEY=
UCM_VIEWER_ACCESS_KEY=
UCM_ADMIN_ACCESS_KEY=
# Explicit production-only exception for operator-chosen keys below 32 bytes.
# Keep false unless independent access controls protect the deployment.
UCM_ALLOW_WEAK_ACCESS_KEYS=false

# Required production request-integrity settings. Generate each independently
# with `openssl rand -hex 32`; list browser origins as comma-separated HTTPS
# URLs.
UCM_CSRF_SECRET=
UCM_AUDIT_IP_SALT=
UCM_ALLOWED_ORIGINS=https://costing.example.org
# Temporary tailnet-only testing escape hatch. Keep false for every HTTPS
# deployment. When true, the only allowed origin must be an explicit
# http://100.64.0.0/10:port Tailscale IPv4 origin, proxy hops must be 0, and
# UCM_BIND_ADDRESS must be that exact Tailscale address.
UCM_ALLOW_INSECURE_HTTP=false
# Exact proxy hops from the browser to Express. The documented deployment has
# one TLS reverse proxy and therefore uses 1. Direct tailnet HTTP testing uses
# 0 because there is no proxy.
UCM_TRUST_PROXY_HOPS=1

# Keep this below PostgreSQL's connection budget across all app replicas.
UCM_DB_POOL_MAX=10

# On Linux, set these to the owner of the directories above:
#   id -u
#   id -g
# macOS Docker Desktop users can normally leave the defaults.
UCM_UID=1000
UCM_GID=1000
